# =============================================================================
# MEDIC-XAI / MedXplain Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# -----------------------------------------------------------------------------
# Local Development:
VITE_API_URL=http://127.0.0.1:5000

# Production on Vercel:
# Set VITE_API_URL in your Vercel Project Settings to your deployed Render URL:
# VITE_API_URL=https://<your-render-backend-service-name>.onrender.com

# -----------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Local Flask)
# -----------------------------------------------------------------------------
# Port is automatically assigned by Render via $PORT (defaults to 5000 locally):
# PORT=5000

# Allowed CORS Origins:
# In local development, defaults to localhost:5173, localhost:5174, localhost:5175, etc.
# In production on Render, set this to your public Vercel frontend URL:
# CORS_ORIGINS=https://<your-vercel-app-name>.vercel.app

# Model Asset Download URL:
# If models/best_densenet121.keras is hosted externally in cloud storage (e.g. S3,
# Hugging Face, or GitHub Releases) rather than bundled in the deployment image:
# MODEL_DOWNLOAD_URL=https://<your-storage-host>/best_densenet121.keras
